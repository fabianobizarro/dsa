[
  {
    "label": "run: cli package",
    "command": "odin",
    "args": ["run", "cli", "-collection:ds=."],
    "tags": ["odin-main"]
  },
  {
    "label": "test: datastructures package",
    "command": "odin",
    "args": [
      "test",
      "$ZED_DIRNAME",
      "-define:ODIN_TEST_CLIPBOARD=false",
      "-define:ODIN_TEST_FANCY=false"
    ],
    "tags": ["odin-test-all"]
  },
  {
    "label": "test: '$ZED_SYMBOL'",
    "command": "odin",
    "args": [
      "test",
      "$ZED_DIRNAME",
      "-define:ODIN_TEST_NAMES=$ZED_SYMBOL",
      "-define:ODIN_TEST_CLIPBOARD=false",
      "-define:ODIN_TEST_FANCY=false"
    ],
    "tags": ["odin-test"]
  },
  {
    "label": "check: cli package",
    "command": "odin",
    "args": ["check", "cli", "-collection:ds=.", "-vet"]
  },
  {
    "label": "check: datastructures package",
    "command": "odin",
    "args": [
      "test",
      "datastructures",
      "-define:ODIN_TEST_CLIPBOARD=false",
      "-define:ODIN_TEST_FANCY=false",
      "-vet"
    ]
  },
  {
    "label": "build: cli package",
    "command": "odin",
    "args": ["build", "cli", "-collection:ds=.", "-debug"]
  }
]
